{%- style -%}
  #shopify-section-{{ section.id }} .feature-banner {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap }}px;
    text-align: {{ section.settings.text_align }};
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .feature-banner__image {
    display: block;
    width: {{ section.settings.image_width }}%;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
{%- endstyle -%}

<div class="feature-banner">

  {%- if section.settings.image != blank -%}
    <img
      class="feature-banner__image"
      src="{{ section.settings.image | image_url: width: 1200 }}"
      srcset="
        {{ section.settings.image | image_url: width: 400 }} 400w,
        {{ section.settings.image | image_url: width: 800 }} 800w,
        {{ section.settings.image | image_url: width: 1200 }} 1200w
      "
      sizes="(min-width: 750px) {{ section.settings.image_width }}vw, 100vw"
      alt="{{ section.settings.image.alt | escape }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="lazy"
    >
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2 class="feature-banner__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.body != blank -%}
    <div class="feature-banner__body">{{ section.settings.body }}</div>
  {%- endif -%}

  {%- if section.settings.link_url != blank and section.settings.link_label != blank -%}
    <a href="{{ section.settings.link_url }}" class="button {{ section.settings.button_style }}">
      {{ section.settings.link_label }}
    </a>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="feature-banner__items">
      {%- for block in section.blocks -%}
        <div class="feature-banner__item" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Feature Banner",
  "tag": "section",
  "class": "section-feature-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the trades"
    },
    {
        "type": "select",
        "id": "text_align",
        "label": "Text alignment",
        "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
        ],
        "default": "center"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    { "type": "range", "id": "image_width", "label": "Image Width", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Shop now"
    },
        {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#5cb0ff"
    },
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Banner",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}